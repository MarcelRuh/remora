// In das Design integrierte Fenster-Titelleiste (Windows).
//
// Ziehen, Doppelklick-Maximieren, Aero Snap und das Systemmenü übernimmt Windows selbst:
// Die Fläche links der Fenster-Buttons meldet der Fenster-Hook (src/app/titlebar.rs) als
// Beschriftungsbereich (HTCAPTION). Breite der Buttons und Höhe müssen zu den Konstanten
// dort passen.

import { Theme, Icons } from "../themes/theme.slint";
import { Bridge } from "../bridge.slint";

component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-close: false;
    // Vom Fenster-Hook gemeldeter Zustand (Maximieren-Button, siehe titlebar.rs)
    in property <bool> hover-external: false;
    in property <bool> pressed-external: false;
    private property <bool> hovered: ta.has-hover || hover-external;
    private property <bool> pressed: ta.pressed || pressed-external;
    callback clicked();
    width: 46px;
    background: pressed ? (is-close ? #b4271a : Theme.text.with-alpha(14%))
        : hovered ? (is-close ? #c42b1c : Theme.text.with-alpha(8%)) : transparent;
    Image {
        source: icon;
        width: 10px;
        height: 10px;
        colorize: (is-close && hovered) ? #ffffff : Bridge.window-active ? Theme.text : Theme.text-faint;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> subtitle;
    height: 34px;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;
        Image {
            source: Icons.logo-32;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            opacity: Bridge.window-active ? 1 : 0.6;
        }
        Text {
            text: "REMORA";
            color: Bridge.window-active ? Theme.brand-pink : Theme.text-faint;
            font-family: Theme.font-display;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.4px;
            vertical-alignment: center;
        }
        if subtitle != "" : Text {
            text: "·  " + subtitle;
            color: Theme.text-faint;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            CaptionButton {
                icon: Icons.win-minimize;
                clicked => { Bridge.window-minimize(); }
            }
            CaptionButton {
                icon: Bridge.window-maximized ? Icons.win-restore : Icons.win-maximize;
                hover-external: Bridge.max-button-hover;
                pressed-external: Bridge.max-button-pressed;
                clicked => { Bridge.window-toggle-maximize(); }
            }
            CaptionButton {
                icon: Icons.win-close;
                is-close: true;
                clicked => { Bridge.window-close(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
